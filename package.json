{
  "name": "@ukegeeks/song-editor",
  "version": "2.0.0-beta.4",
  "description": "UkeGeeks Song-a-Matic: a browser editor for ChordPro songs with ukulele chord diagrams, menus, transpose and a Chord Builder",
  "license": "GPL-3.0-or-later",
  "author": "Buz Carter <buz@ukegeeks.org>",
  "homepage": "https://github.com/buzcarter/song-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzcarter/song-editor.git"
  },
  "bugs": {
    "url": "https://github.com/buzcarter/song-editor/issues"
  },
  "keywords": [
    "ukulele",
    "chordpro",
    "chords",
    "songbook",
    "editor",
    "ukegeeks"
  ],
  "type": "commonjs",
  "main": "./dist/markup.js",
  "types": "./dist/markup.d.ts",
  "exports": {
    ".": {
      "types": "./dist/markup.d.ts",
      "default": "./dist/markup.js"
    },
    "./markup": {
      "types": "./dist/markup.d.ts",
      "default": "./dist/markup.js"
    },
    "./browser": {
      "types": "./dist/ugsEditorPlus.d.ts",
      "default": "./dist/js/ugsEditorPlus.min.js"
    },
    "./chord-builder": {
      "types": "./dist/ugsChordBuilder.d.ts",
      "default": "./dist/js/ugsChordBuilder.min.js"
    },
    "./css": "./dist/css/ugsEditorPlus.min.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/js/ugsEditorPlus.min.js",
  "jsdelivr": "./dist/js/ugsEditorPlus.min.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:js": "node scripts/build.js js",
    "build:css": "node scripts/build.js css",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test",
    "build:site": "node scripts/build-site.js",
    "demo": "npm run build && node scripts/demo.js",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@ukegeeks/ace-chordpro-extension": "^1.0.0",
    "@ukegeeks/song-formatter": "^1.0.0-beta.1"
  },
  "peerDependenciesMeta": {
    "@ukegeeks/ace-chordpro-extension": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ukegeeks/ace-chordpro-extension": "^1.0.0",
    "@ukegeeks/song-formatter": "^1.0.0-beta.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "less": "^4.9.1",
    "terser": "^5.51.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  }
}
